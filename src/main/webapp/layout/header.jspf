<%@ page pageEncoding="UTF-8" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><c:out value="${tieuDe}"/> — The Royal Hotel</title>
    <link rel="stylesheet" href="${ctx}/css/main.css">
    <link rel="stylesheet" href="${ctx}/css/royal-jsp.css">
    <link href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
</head>
<body>
<div class="app-shell">

    <aside class="sidebar" id="sidebar">
        <div class="brand">
            <div class="brand-mark"><img src="${ctx}/assets/logo-royal.png" alt="The Royal Hotel Logo"></div>
            <div class="brand-info">
                <div class="brand-name">THE ROYAL</div>
                <div class="brand-sub">HOTEL MANAGEMENT</div>
            </div>
        </div>

        <div class="side-label">MENU CHÍNH</div>
        <nav>
            <a class="nav-item" href="${ctx}/#tong_quan"><i class='bx bx-grid-alt'></i> Tổng quan</a>

            <div class="nav-label">VẬN HÀNH KHÁCH SẠN</div>
            <a class="nav-item ${menu eq 'phong' ? 'active' : ''}" href="${ctx}/quan-ly-phong/view"><i class='bx bx-hotel'></i> Quản lý sơ đồ phòng</a>
            <a class="nav-item ${menu eq 'don' ? 'active' : ''}" href="${ctx}/dat-phong"><i class='bx bx-calendar-check'></i> Quản lý đặt phòng</a>
            <a class="nav-item ${menu eq 'loai-phong' ? 'active' : ''}" href="${ctx}/loai-phong"><i class='bx bx-layer'></i> Danh mục loại phòng</a>
            <a class="nav-item ${menu eq 'khach-hang' ? 'active' : ''}" href="${ctx}/quan-ly-khach-hang/view"><i class='bx bx-user'></i> Khách hàng</a>
            <a class="nav-item ${menu eq 'nhan-vien' ? 'active' : ''}" href="${ctx}/quan-ly-nhan-vien/view"><i class='bx bx-id-card'></i> Nhân sự &amp; Nhân viên</a>

            <div class="nav-label">DỊCH VỤ &amp; TÀI CHÍNH</div>
            <a class="nav-item ${menu eq 'tien-nghi' ? 'active' : ''}" href="${ctx}/tien-nghi"><i class='bx bx-spa'></i> Tiện nghi phòng</a>
            <a class="nav-item ${menu eq 'dich-vu' ? 'active' : ''}" href="${ctx}/quan-ly-dich-vu/view"><i class='bx bx-dish'></i> Dịch vụ đi kèm</a>
            <a class="nav-item ${menu eq 'thanh-toan' ? 'active' : ''}" href="${ctx}/thanh-toan"><i class='bx bx-receipt'></i> Hóa đơn &amp; Thanh toán</a>
            <a class="nav-item ${menu eq 'ma-giam-gia' ? 'active' : ''}" href="${ctx}/ma-giam-gia"><i class='bx bx-purchase-tag-alt'></i> Khuyến mãi &amp; Ưu đãi</a>

            <div class="nav-label">CHẤT LƯỢNG TRẢI NGHIỆM</div>
            <a class="nav-item ${menu eq 'danh-gia' ? 'active' : ''}" href="${ctx}/quan-ly-danh-gia/view"><i class='bx bx-star'></i> Phản hồi &amp; Đánh giá</a>
        </nav>

        <div class="sidebar-bottom">
            <div class="support-icon"><i class='bx bx-support'></i></div>
            <div>
                <b>Trung tâm hỗ trợ IT</b>
                <small>Hotline: 1900-ROYAL (24/7)</small>
            </div>
        </div>
    </aside>

    <main class="main-area">
        <header class="topbar">
            <button class="mobile-menu" id="mobileMenu" type="button" aria-label="Mở thanh điều hướng"><i class='bx bx-menu'></i></button>
            <div class="breadcrumb">
                <span>THE ROYAL HOTEL</span><i>/</i><b><c:out value="${tieuDe}"/></b>
            </div>
            <div class="top-actions">
                <div class="top-divider"></div>
                <div class="profile">
                    <div class="avatar"><i class='bx bxs-user'></i></div>
                    <div class="profile-info"><b>Administrator</b><small>Quản trị viên cấp cao</small></div>
                </div>
            </div>
        </header>

        <section class="content">
<c:if test="${not empty loi}"><div class="alert alert-danger" role="alert"><i class='bx bx-error-circle'></i> <c:out value="${loi}"/></div></c:if>
