<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="tieuDe" value="Quản lý thanh toán"/><c:set var="menu" value="thanh-toan"/><%@ include file="/WEB-INF/views/layout/header.jspf" %>
<div class="page-heading"><div><div class="eyebrow">DỊCH VỤ &amp; TÀI CHÍNH</div><h1>Quản lý thanh toán</h1><p>Theo dõi giao dịch đặt phòng, phương thức và trạng thái thanh toán.</p></div><div class="heading-actions"><span class="date-chip" data-today></span><a class="btn btn-primary" href="${ctx}/thanh-toan?action=form"><i class='bx bx-plus'></i> Tạo giao dịch</a></div></div>
<form class="toolbar" method="get" action="${ctx}/thanh-toan"><div class="toolbar-left"><div class="search-wrap"><i class='bx bx-search'></i><input class="search-input" name="tuKhoa" value="<c:out value='${tuKhoa}'/>" placeholder="Mã đặt phòng hoặc tên khách..."></div><select name="trangThai"><option value="">Tất cả trạng thái</option><option value="CHO_XU_LY" ${trangThai eq 'CHO_XU_LY'?'selected':''}>Chờ xử lý</option><option value="THANH_CONG" ${trangThai eq 'THANH_CONG'?'selected':''}>Thành công</option><option value="THAT_BAI" ${trangThai eq 'THAT_BAI'?'selected':''}>Thất bại</option><option value="DA_HOAN" ${trangThai eq 'DA_HOAN'?'selected':''}>Đã hoàn</option></select><button class="btn btn-ghost">Lọc</button></div></form>
<div class="table-panel"><div class="table-scroll"><table><thead><tr><th>Mã GD</th><th>Mã đặt phòng</th><th>Khách hàng</th><th>Phương thức</th><th class="num">Số tiền</th><th>Trạng thái</th><th>Cập nhật</th></tr></thead><tbody>
<c:forEach var="t" items="${dsThanhToan}"><tr><td>#${t[0]}</td><td><b>${t[1]}</b></td><td><c:out value="${t[2]}"/></td><td>${t[3]}</td><td class="num"><b><fmt:formatNumber value="${t[4]}" type="number" maxFractionDigits="0"/> ₫</b></td><td><span class="status-pill">${t[5]}</span></td><td><c:if test="${t[5] eq 'CHO_XU_LY'}"><form class="actions" method="post" action="${ctx}/thanh-toan"><input type="hidden" name="action" value="trangThai"><input type="hidden" name="id" value="${t[0]}"><button class="btn btn-success btn-small" name="trangThai" value="THANH_CONG" onclick="return confirm('Xác nhận giao dịch thành công?')">Xác nhận</button><button class="btn btn-danger btn-small" name="trangThai" value="THAT_BAI" onclick="return confirm('Đánh dấu giao dịch thất bại?')">Thất bại</button></form></c:if><c:if test="${t[5] eq 'THANH_CONG'}"><form class="actions" method="post" action="${ctx}/thanh-toan" onsubmit="return confirm('Đánh dấu giao dịch này đã được hoàn tiền?')"><input type="hidden" name="action" value="trangThai"><input type="hidden" name="id" value="${t[0]}"><button class="btn btn-ghost btn-small" name="trangThai" value="DA_HOAN">Ghi nhận hoàn tiền</button></form></c:if><c:if test="${t[5] ne 'CHO_XU_LY' and t[5] ne 'THANH_CONG'}">—</c:if></td></tr></c:forEach>
<c:if test="${empty dsThanhToan}"><tr><td colspan="7" class="empty-box">Chưa có giao dịch thanh toán.</td></tr></c:if></tbody></table></div><div class="table-footer">Tổng cộng ${dsThanhToan.size()} giao dịch</div></div>
<div class="panel" style="margin-top:18px"><b>Lưu ý nghiệp vụ</b><p>Chỉ khi giao dịch chuyển sang <b>THANH_CONG</b>, hệ thống mới cộng tiền vào số đã thanh toán của đơn đặt phòng. Việc xác nhận ở đây là thao tác quản trị nội bộ, không kết nối ngân hàng hoặc cổng VNPay thật.</p></div>
<%@ include file="/WEB-INF/views/layout/footer.jspf" %>
