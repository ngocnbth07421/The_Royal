<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="tieuDe" value="Mã giảm giá"/><c:set var="menu" value="ma-giam-gia"/><%@ include file="/WEB-INF/views/layout/header.jspf" %>
<div class="page-heading"><div><div class="eyebrow">DỊCH VỤ &amp; TÀI CHÍNH</div><h1>Mã giảm giá</h1><p>Quản lý mã ưu đãi, thời hạn và lượt sử dụng.</p></div><div class="heading-actions"><span class="date-chip" data-today></span><a class="btn btn-primary" href="${ctx}/ma-giam-gia?action=form"><i class='bx bx-plus'></i> Tạo mã giảm giá</a></div></div>
<form class="toolbar" method="get" action="${ctx}/ma-giam-gia"><div class="toolbar-left"><div class="search-wrap"><i class='bx bx-search'></i><input class="search-input" name="tuKhoa" value="<c:out value='${tuKhoa}'/>" placeholder="Nhập mã giảm giá..."></div><button class="btn btn-ghost">Tìm</button></div></form>
<div class="table-panel"><div class="table-scroll"><table><thead><tr><th>Mã</th><th>Kiểu giảm</th><th>Giá trị</th><th>Hiệu lực từ</th><th>Đến</th><th>Lượt dùng</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
<c:forEach var="m" items="${dsMaGiamGia}"><tr><td><b><c:out value="${m[1]}"/></b></td><td>${m[2] eq 'PHAN_TRAM' ? 'Phần trăm' : 'Số tiền'}</td><td><b><fmt:formatNumber value="${m[3]}" type="number" maxFractionDigits="2"/>${m[2] eq 'PHAN_TRAM' ? '%' : ' ₫'}</b></td><td>${m[4]}</td><td>${m[5]}</td><td>${m[6]} / ${m[8]} đơn</td><td><span class="status-pill ${m[7] eq 'HOAT_DONG' ? 'status-success' : 'status-muted'}">${m[7]}</span></td><td><div class="actions"><a class="btn btn-ghost btn-small" href="${ctx}/ma-giam-gia?action=form&id=${m[0]}">Sửa</a><form class="inline-form" method="post" action="${ctx}/ma-giam-gia" onsubmit="return confirm('Xóa mã giảm giá?')"><input type="hidden" name="action" value="xoa"><input type="hidden" name="id" value="${m[0]}"><button class="btn btn-danger btn-small">Xóa</button></form></div></td></tr></c:forEach>
<c:if test="${empty dsMaGiamGia}"><tr><td colspan="8" class="empty-box">Chưa có mã giảm giá.</td></tr></c:if></tbody></table></div><div class="table-footer">Tổng cộng ${dsMaGiamGia.size()} mã</div></div><%@ include file="/WEB-INF/views/layout/footer.jspf" %>
