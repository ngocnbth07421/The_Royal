<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="tieuDe" value="Quản lý loại phòng"/><c:set var="menu" value="loai-phong"/><%@ include file="/WEB-INF/views/layout/header.jspf" %>
<div class="page-heading"><div><div class="eyebrow">VẬN HÀNH KHÁCH SẠN</div><h1>Quản lý loại phòng</h1><p>Thiết lập hạng phòng, loại giường và giá niêm yết theo mỗi đêm.</p></div><div class="heading-actions"><span class="date-chip" data-today></span><a class="btn btn-primary" href="${ctx}/loai-phong?action=form"><i class='bx bx-plus'></i> Thêm loại phòng</a></div></div>
<form class="toolbar" method="get" action="${ctx}/loai-phong"><div class="toolbar-left"><div class="search-wrap"><i class='bx bx-search'></i><input class="search-input" type="search" name="tuKhoa" value="<c:out value='${tuKhoa}'/>" placeholder="Tìm tên loại phòng hoặc mã hạng..."></div><button class="btn btn-ghost">Tìm kiếm</button></div></form>
<div class="table-panel"><div class="table-scroll"><table><thead><tr><th>ID</th><th>Tên loại phòng</th><th>Hạng phòng</th><th>Loại giường</th><th class="num">Giá / đêm</th><th class="num">Số phòng</th><th>Thao tác</th></tr></thead><tbody>
<c:forEach var="r" items="${dsLoaiPhong}"><tr><td>${r[0]}</td><td><b><c:out value="${r[1]}"/></b><small class="muted"><c:out value="${r[5]}"/></small></td><td>${r[2]}</td><td>${r[3]}</td><td class="num"><fmt:formatNumber value="${r[4]}" type="number" maxFractionDigits="0"/> ₫</td><td class="num">${r[6]}</td><td><div class="actions"><a class="btn btn-ghost btn-small" href="${ctx}/loai-phong?action=form&id=${r[0]}"><i class='bx bx-edit'></i> Sửa</a><form class="inline-form" method="post" action="${ctx}/loai-phong" onsubmit="return confirm('Xóa loại phòng này?')"><input type="hidden" name="action" value="xoa"><input type="hidden" name="id" value="${r[0]}"><button class="btn btn-danger btn-small"><i class='bx bx-trash'></i> Xóa</button></form></div></td></tr></c:forEach>
<c:if test="${empty dsLoaiPhong}"><tr><td colspan="7" class="empty-box">Chưa có loại phòng phù hợp.</td></tr></c:if></tbody></table></div><div class="table-footer">Tổng cộng ${dsLoaiPhong.size()} loại phòng</div></div>
<%@ include file="/WEB-INF/views/layout/footer.jspf" %>
